# Copy to .env.local for local dev. In production set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Supabase (Project Settings -> API). The service-role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string. The Supabase scheduler sends it to /api/tick. Generate with: openssl rand -hex 32
CRON_SECRET=

# Password for the dashboard (browser login: any username + this password).
DASHBOARD_PASSWORD=

# paper (default) or live.
TRADING_MODE=paper
# Simulated starting balance for paper mode.
PAPER_STARTING_BALANCE=500

# --- Live trading only. Leave blank until paper results justify it. ---
# CoinJar Exchange -> Settings -> API Keys. Trading permission only; no withdrawals.
COINJAR_API_KEY=
# Must be exactly "yes" for TRADING_MODE=live to start.
LIVE_TRADING_ACKNOWLEDGED=

# --- JEV (TypeSafe AI). Leave blank until you have access. ---
JEV_API_KEY=
JEV_API_URL=
